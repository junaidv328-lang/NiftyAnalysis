# ──────────────────────────────────────────────────────────────────────
#  SECRETS TEMPLATE
#  Copy to .streamlit/secrets.toml for LOCAL DEV.
#  On Streamlit Cloud: App -> Settings -> Secrets -> paste these.
#  NEVER commit secrets.toml (it is in .gitignore).
# ──────────────────────────────────────────────────────────────────────

# Required: gates the app behind a password.
app_password = "change-me-to-something-long-and-random"

# Optional: pre-fill the Angel One login form. Leave blank to type
# manually each session.
angel_api_key   = ""
angel_client_id = ""
angel_password  = ""
angel_totp_key  = ""
